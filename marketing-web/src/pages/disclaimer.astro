---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  path="/disclaimer"
  title="Medical Disclaimer — Aegi"
  description="Medical disclaimer for Aegi, the pregnancy and baby tracker app by Zerothreeone LLC."
>
  <main class="legal-page">
    <div class="wrap">
      <header class="legal-header">
        <h1>Medical Disclaimer</h1>
        <p class="legal-meta">Effective Date: May 23, 2026</p>
      </header>

      <div class="legal-body">

        <section>
          <p>Aegi is intended solely for informational, organizational, wellness, journaling, and tracking purposes.</p>
          <p>Aegi is not a medical device and is not intended to diagnose, monitor, treat, cure, or prevent any medical condition. The App does not provide medical advice, professional healthcare services, diagnosis, or treatment recommendations.</p>
          <p>Any pregnancy tracking, contraction timing, kick counting, feeding logs, sleep tracking, growth information, reminders, insights, notifications, or other content provided within the App are for general informational and personal tracking purposes only and should not be relied upon as medical guidance.</p>
        </section>

        <section>
          <p>Always seek the advice of a qualified physician, healthcare provider, or medical professional regarding any medical concerns, symptoms, pregnancy-related questions, labor concerns, or healthcare decisions.</p>
          <p>Never disregard professional medical advice or delay seeking medical care because of information provided by the App.</p>
          <p>If you believe you are experiencing a medical emergency, contact emergency services or your healthcare provider immediately.</p>
        </section>

        <section>
          <p>By using Aegi, you acknowledge and agree that:</p>
          <ul>
            <li>The App is not a substitute for professional medical care</li>
            <li>The App does not establish a doctor-patient relationship</li>
            <li>Use of the App is at your own discretion and risk</li>
          </ul>
        </section>

        <section>
          <p>Aegi is operated by Zerothreeone LLC, a California limited liability company.</p>
          <p>For questions regarding this disclaimer, contact:<br /><a href="mailto:support@zerothreeone.dev">support@zerothreeone.dev</a></p>
        </section>

      </div>
    </div>
  </main>
</BaseLayout>
