---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import ProductIntro from '../components/ProductIntro.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import AppModes from '../components/AppModes.astro';
import AppShowcase from '../components/AppShowcase.astro';
import StatsSection from '../components/StatsSection.astro';
import Testimonial from '../components/Testimonial.astro';
import FAQ from '../components/FAQ.astro';
import CTASection from '../components/CTASection.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="aegi — Pregnancy & Baby Tracker App | Feed, Sleep & Diaper Log"
  description="aegi is a calm pregnancy and baby tracker — log feeds, diapers, sleep, growth and milestones, time contractions, count kicks, and keep a private journal. Free in early access."
>
  <Nav />

  <main>
    <Hero />
    <ProductIntro />
    <FeaturesGrid />
    <AppModes />
    <AppShowcase />
    <StatsSection />
    <Testimonial />
    <FAQ />
    <CTASection />
  </main>

  <Footer />
</Layout>
