---
import PhoneMockup from './PhoneMockup.astro';
import AppChrome from './AppChrome.astro';
---

<header data-scene aria-label="Hero">
  <div data-scene-content>
    <div class="section-inner hero-grid">
      <div class="hero-text">
        <span class="section-number">001</span>

        <div class="hero-eyebrow label">
          <span class="pulse"></span> Pregnancy &amp; newborn tracker &middot; early access
        </div>

        <h1 class="hero-headline" data-text-reveal>
          track /<br />
          remember /<br />
          breathe.
        </h1>

        <p class="hero-sub">
          aegi is a calm pregnancy and baby tracker — part journal, part keepsake, part quiet
          routine. Log feeds, sleep, and diapers in a tap; remember what you'd never want to forget.
        </p>

        <div class="hero-actions">
          <button class="btn btn-primary">Begin your journey with aegi &nbsp;&rarr;</button>
          <span class="hero-note label">free during early access</span>
        </div>
      </div>

      <div class="hero-visual" data-reveal>
        <PhoneMockup>
          <AppChrome name="Koyun" />

          <div class="pg-week">
            <div class="pg-week-row">
              <span class="pg-wk">week 32</span>
              <svg class="pg-arrow" width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M8 13V3M3.5 7.5 8 3l4.5 4.5"></path>
              </svg>
            </div>
            <div class="pg-size">about the size of <b>pineapple</b> <span class="pg-fruit"></span></div>
            <div class="pg-due">due on <b>Jul 19, 2026</b></div>
          </div>

          <div class="pg-grid">
            <div class="app-tile">
              <div class="lbl">water
                <svg class="ic" style="color:var(--c-feed)" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M2 8c2.4-3 4.8 3 7.2 0S14 5 16.4 8s4.8 3 7.2 0"></path><path d="M2 15c2.4-3 4.8 3 7.2 0S14 12 16.4 15s4.8 3 7.2 0"></path></svg>
              </div>
              <div class="meta">Today</div>
              <div class="val">350 ml</div>
            </div>
            <div class="app-tile">
              <div class="lbl">weight
                <svg class="ic" style="color:var(--c-diaper)" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 5.5a3 3 0 0 1 6 0h-2a1 1 0 0 0-2 0H9zM6.8 7.5h10.4l1.7 12.5H5.1z"></path></svg>
              </div>
              <div class="meta">May 22</div>
              <div class="val">78.0 kg</div>
            </div>
            <div class="app-tile">
              <div class="lbl">mood
                <svg class="ic" style="color:var(--c-mood)" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" aria-hidden="true"><path d="M3 15c2-5 4-5 6 0s4 5 6 0 4-5 6 0"></path></svg>
              </div>
              <div class="meta">May 22</div>
              <div class="val">happy</div>
            </div>
          </div>

          <div class="pg-grid pg-grid2">
            <div class="app-tile">
              <div class="lbl">bp
                <svg class="ic" style="color:var(--c-bp)" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 20S4 14.5 4 9a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 9c0 5.5-8 11-8 11z"></path></svg>
              </div>
              <div class="meta">May 20</div>
              <div class="val">110 / 70</div>
            </div>
            <div class="app-tile">
              <div class="lbl">med
                <svg class="ic" style="color:var(--c-amber)" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="2.8" y="8.6" width="18.4" height="6.8" rx="3.4" transform="rotate(-42 12 12)"></rect><line x1="9" y1="6.7" x2="15" y2="17.3"></line></svg>
              </div>
              <div class="meta">May 22</div>
              <div class="val">Vitamins</div>
            </div>
          </div>

          <div class="app-dock">
            <div class="app-pill">
              <span class="seg on">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11 12 4l8 7M6 10v9h12v-9"></path></svg>
              </span>
              <span class="seg">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12M6 21h12M7 3c0 5 4 6 5 9 1-3 5-4 5-9M7 21c0-5 4-6 5-9 1 3 5 4 5 9"></path></svg>
              </span>
            </div>
            <div class="app-fab">+</div>
          </div>
        </PhoneMockup>
      </div>
    </div>
  </div>
</header>

<style>
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  .hero-text {
    max-width: 600px;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    border-radius: 999px;
    background: var(--bg-subtle);
    border: 1px solid var(--line);
    color: var(--ink);
    margin-bottom: 28px;
  }

  .pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent-deep);
    box-shadow: 0 0 0 4px rgba(217, 147, 127, 0.25);
  }

  .hero-headline {
    font-family: "Urbanist", sans-serif;
    font-weight: 700;
    font-size: clamp(52px, 7vw, 100px);
    line-height: 0.96;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .hero-sub {
    margin-top: 28px;
    max-width: 44ch;
    font-size: 18px;
    line-height: 1.55;
    color: var(--ink-soft);
  }

  .hero-actions {
    display: flex;
    gap: 18px;
    margin-top: 36px;
    align-items: center;
  }

  .hero-note {
    color: var(--ink-mute);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
  }

  /* Pregnancy home screen */
  .pg-week {
    margin-top: 22px;
  }
  .pg-week-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .pg-wk {
    font-size: 17px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .pg-arrow { color: var(--ink-mute); }
  .pg-size {
    margin-top: 5px;
    font-size: 13px;
    line-height: 1.35;
    color: var(--ink-mute);
  }
  .pg-size b { color: var(--ink); font-weight: 600; }
  .pg-fruit {
    display: inline-block;
    width: 12px;
    height: 12px;
    margin-left: 3px;
    border-radius: 50%;
    vertical-align: -1px;
    background: radial-gradient(circle at 35% 30%, #F2D44E, #D9B838);
  }
  .pg-due {
    margin-top: 14px;
    font-size: 13px;
    color: var(--ink-mute);
  }
  .pg-due b { color: var(--ink); font-weight: 600; }

  .pg-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
    margin-top: 16px;
  }
  .pg-grid2 {
    grid-template-columns: 1fr 1fr;
    margin-top: 8px;
  }

  @media (max-width: 1024px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      text-align: center;
    }
    .hero-text {
      max-width: 100%;
    }
    .hero-sub {
      margin-inline: auto;
    }
    .hero-actions {
      justify-content: center;
    }
  }

  @media (max-width: 768px) {
    .hero-grid {
      gap: 32px;
    }
    .hero-headline {
      font-size: clamp(36px, 12vw, 52px);
    }
    .hero-sub {
      font-size: 16px;
      margin-top: 20px;
    }
    .hero-actions {
      flex-direction: column;
      align-items: center;
      margin-top: 24px;
    }
    .hero-eyebrow {
      margin-bottom: 20px;
    }
  }
</style>
