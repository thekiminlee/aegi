<nav class="nav" id="main-nav">
  <a href="/" class="nav-logo logo-font" aria-label="aegi home">aegi</a>

  <div class="nav-right">
    <a href="#cta" class="btn btn-accent nav-cta-btn">Get aegi</a>
    <button class="nav-hamburger" aria-label="Menu">
      <span></span>
      <span></span>
    </button>
  </div>
</nav>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 40px;
    backdrop-filter: blur(10px);
    background: rgba(255, 255, 255, 0.6);
    transition: all 0.3s ease;
  }

  .nav:global(.nav-scrolled) {
    backdrop-filter: blur(20px);
    background: rgba(255, 255, 255, 0.92);
    padding: 16px 40px;
    border-bottom: 1px solid var(--line-soft);
  }

  .nav-logo {
    font-size: 28px;
    letter-spacing: -0.02em;
  }

  .nav-right {
    display: flex;
    gap: 16px;
    align-items: center;
  }

  .nav-cta-btn {
    padding: 10px 22px;
    font-size: 13px;
  }

  .nav-hamburger {
    width: 36px;
    height: 36px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }

  .nav-hamburger span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    border-radius: 1px;
    transition: all 0.25s ease;
  }

  .nav-hamburger:hover span {
    background: var(--ink-soft);
  }

  @media (max-width: 768px) {
    .nav {
      padding: 16px 20px;
    }
    .nav-cta-btn {
      padding: 8px 16px;
      font-size: 12px;
    }
  }
</style>
