---
const faqs = [
  {
    q: 'Is aegi a free baby tracker?',
    a: 'Yes. aegi is free during early access. You can log feeds, diapers, sleep, growth, and milestones, and keep a private journal — no subscription required to get started.',
  },
  {
    q: 'Can aegi track my pregnancy week by week?',
    a: 'Yes. aegi is a week-by-week pregnancy tracker with size comparisons, a due-date countdown, and gentle logging for weight, mood, blood pressure, water, and medications.',
  },
  {
    q: 'What can I log with the newborn and infant tracker?',
    a: 'You can log feeds (formula, expressed, or breastfeeding), diaper changes (wet and dirty), sleep, and growth — most entries take a single tap, with a 24-hour timeline of every event.',
  },
  {
    q: 'Does aegi have a contraction timer and kick counter?',
    a: 'Yes. aegi includes a contraction timer that tracks duration and interval, plus a kick counter for daily fetal movement. aegi is not a medical device — always consult your care provider.',
  },
  {
    q: 'Is my data private, and does aegi work offline?',
    a: 'Your entries stay private to your family and the app works offline, so you can log a feed or write a journal entry anytime — even without a connection.',
  },
  {
    q: 'Is aegi available on iPhone and Android?',
    a: 'aegi launches on iOS in spring 2026 with Android to follow in summer. Join early access to be among the first to use the pregnancy and baby tracker.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<section data-scene aria-label="Frequently asked questions" id="faq">
  <div data-scene-content>
    <div class="section-inner">
      <span class="section-number">010</span>
      <h2 class="section-title" data-text-reveal>
        Questions, <em class="it">answered.</em>
      </h2>
      <p class="section-lede">
        Everything about using aegi as a pregnancy tracker, baby tracker, and private journal.
      </p>

      <div class="faq-list" data-stagger>
        {faqs.map((f) => (
          <details class="faq-item" data-reveal>
            <summary>
              <span class="faq-q">{f.q}</span>
              <span class="faq-mark" aria-hidden="true"></span>
            </summary>
            <p class="faq-a">{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-list {
    margin-top: 36px;
    max-width: 760px;
  }

  .faq-item {
    border-top: 1px solid var(--line);
  }
  .faq-item:last-child {
    border-bottom: 1px solid var(--line);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 22px 4px;
    cursor: pointer;
    list-style: none;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-q {
    font-family: "Urbanist", sans-serif;
    font-weight: 600;
    font-size: clamp(16px, 2vw, 20px);
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .faq-mark {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .faq-mark::before,
  .faq-mark::after {
    content: "";
    position: absolute;
    background: var(--accent-deep);
    border-radius: 1px;
    transition: transform 0.25s ease;
  }
  .faq-mark::before {
    top: 7px;
    left: 0;
    width: 16px;
    height: 2px;
  }
  .faq-mark::after {
    top: 0;
    left: 7px;
    width: 2px;
    height: 16px;
  }
  .faq-item[open] .faq-mark::after {
    transform: rotate(90deg);
  }

  .faq-a {
    padding: 0 4px 24px;
    max-width: 64ch;
    font-size: 16px;
    line-height: 1.6;
    color: var(--ink-soft);
  }

  @media (max-width: 768px) {
    .faq-list {
      margin-top: 28px;
    }
    .faq-item summary {
      padding: 18px 2px;
      gap: 16px;
    }
    .faq-a {
      font-size: 15px;
      padding-bottom: 20px;
    }
  }
</style>
