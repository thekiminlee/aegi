<style>
  .footer {
    padding: 80px var(--gutter) 60px;
    border-top: 1px solid var(--line);
    text-align: center;
  }

  .foot-inner {
    max-width: var(--container);
    margin: 0 auto;
  }

  .foot-values {
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .foot-bottom {
    margin-top: 40px;
    display: flex;
    justify-content: space-between;
    color: var(--ink-mute);
    font-size: 12px;
  }

  .foot-medical {
    max-width: 48ch;
    text-align: right;
  }

  @media (max-width: 768px) {
    .footer {
      padding: 60px 20px 40px;
    }
    .foot-values {
      font-size: 16px;
    }
    .foot-bottom {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
    .foot-medical {
      text-align: center;
      max-width: 100%;
    }
  }
