---
import PhoneMockup from './PhoneMockup.astro';
import AppChrome from './AppChrome.astro';
---

<!-- 005 — Journal -->
<section data-scene aria-label="Private baby journal" id="memories">
  <div data-scene-content>
    <div class="section-inner">
      <div class="feature">
        <div class="feature-text">
          <span class="section-number">005</span>
          <h2 data-text-reveal>A private baby journal you'll <em class="it">come back to.</em></h2>
          <p>
            Every entry and small remembering — completely private for your family — finds its way
            into a quiet timeline. Write a letter, tag a memory, available to you anytime, even offline.
          </p>
        </div>
        <div class="feature-vis" data-reveal>
          <PhoneMockup>
            <AppChrome name="Koyun" />
            <div class="jr-list">
              <article class="jr-card">
                <div class="jr-top">
                  <span class="jr-date"><span class="jr-dot"></span>MAY 22 &middot; 23D</span>
                  <svg class="jr-go" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                </div>
                <p class="jr-body">Your tiny hands, soft smiles, and sleepy cuddles fill our home with so much love and joy.</p>
                <span class="app-tag">#love</span>
              </article>
              <article class="jr-card">
                <div class="jr-top">
                  <span class="jr-date"><span class="jr-dot"></span>MAY 21 &middot; 22D</span>
                  <svg class="jr-go" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 5l7 7-7 7"></path></svg>
                </div>
                <p class="jr-body">Today you fell asleep in my arms while the rain tapped softly against the window.</p>
                <span class="app-tag">#rain</span>
              </article>
            </div>
            <div class="app-dock">
              <div class="app-pill">
                <span class="seg">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11 12 4l8 7M6 10v9h12v-9"></path></svg>
                </span>
                <span class="seg">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17 10 11l4 4 6-7M14 8h6v6"></path></svg>
                </span>
              </div>
              <div class="app-fab">+</div>
            </div>
          </PhoneMockup>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 006 — Newborn home -->
<section data-scene aria-label="Newborn feed, sleep and diaper log" id="newborn">
  <div data-scene-content>
    <div class="section-inner">
      <div class="feature reverse">
        <div class="feature-text">
          <span class="section-number">006</span>
          <h2 data-text-reveal>Newborn feed, sleep &amp; <em class="it">diaper log.</em></h2>
          <p>
            Quiet quick-entry for the tired hours. One tap logs a feed, a nap, or a change —
            with a gentle home screen that shows how long it's been, at a glance.
          </p>
        </div>
        <div class="feature-vis" data-reveal>
          <PhoneMockup>
            <AppChrome name="Koyun" />
            <div class="nb-head">
              <div class="nb-age">3 weeks</div>
              <div class="nb-born">born on <b>Apr 29, 2026</b></div>
            </div>
            <div class="nb-grid">
              <div class="app-tile">
                <div class="lbl">feed
                  <svg class="ic" style="color:var(--c-feed)" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M9.5 6h5l.6 13.5a2 2 0 0 1-2 2.5h-2.2a2 2 0 0 1-2-2.5z"></path><path d="M9.8 11h4.4"></path></svg>
                </div>
                <div class="meta">100 ml</div>
                <div class="val">1h 21m ago</div>
              </div>
              <div class="app-tile">
                <div class="lbl">sleep
                  <svg class="ic" style="color:var(--c-sleep)" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
                </div>
                <div class="meta">25m</div>
                <div class="val">6h 7m ago</div>
              </div>
              <div class="app-tile">
                <div class="lbl">wet
                  <svg class="ic" style="color:var(--c-diaper)" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3c4.2 6 6.2 9 6.2 12.2A6.2 6.2 0 0 1 5.8 15c0-3.2 2-6.2 6.2-12z"></path></svg>
                </div>
                <div class="val nb-only">1h 21m ago</div>
              </div>
              <div class="app-tile">
                <div class="lbl">dirty
                  <svg class="ic" style="color:var(--c-amber)" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 18a4 4 0 0 1 0-8 5 5 0 0 1 9.7-1.7A3.5 3.5 0 0 1 17 18z"></path></svg>
                </div>
                <div class="val nb-only">2h 7m ago</div>
              </div>
            </div>
            <div class="app-dock">
              <div class="app-pill">
                <span class="seg on">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11 12 4l8 7M6 10v9h12v-9"></path></svg>
                </span>
                <span class="seg">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17 10 11l4 4 6-7M14 8h6v6"></path></svg>
                </span>
              </div>
              <div class="app-fab">+</div>
            </div>
          </PhoneMockup>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 007 — Trends -->
<section data-scene aria-label="Feeding and growth trends" id="trends">
  <div data-scene-content>
    <div class="section-inner">
      <div class="feature">
        <div class="feature-text">
          <span class="section-number">007</span>
          <h2 data-text-reveal>Feeding &amp; growth trends, <em class="it">at a glance.</em></h2>
          <p>
            Daily feeds, diapers, and sleep gather into soft weekly charts — so patterns surface
            on their own, without spreadsheets or guesswork.
          </p>
        </div>
        <div class="feature-vis" data-reveal>
          <PhoneMockup>
            <AppChrome name="Koyun" />
            <div class="tr-num">435 <small>ml</small></div>
            <div class="tr-legend">
              <span><i style="background:var(--c-feed)"></i>Formula <b>435</b></span>
              <span><i style="background:var(--c-lav)"></i>Expressed <b>0</b></span>
              <span><i style="background:#C7CAE8"></i>Breast <b>0</b></span>
            </div>
            <div class="tr-chart">
              <svg viewBox="0 0 240 76" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <linearGradient id="trg" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="var(--c-feed)" stop-opacity="0.32"></stop>
                    <stop offset="1" stop-color="var(--c-feed)" stop-opacity="0"></stop>
                  </linearGradient>
                </defs>
                <path d="M0,30 C28,18 42,14 70,26 C100,39 116,58 146,52 C176,46 198,30 240,36 L240,76 L0,76 Z" fill="url(#trg)"></path>
                <path d="M0,30 C28,18 42,14 70,26 C100,39 116,58 146,52 C176,46 198,30 240,36" fill="none" stroke="var(--c-feed)" stroke-width="2.4" stroke-linecap="round"></path>
              </svg>
              <div class="tr-axis"><span>Sa</span><span>Su</span><span>Mo</span><span>Tu</span><span>We</span><span>Th</span><span>Fr</span></div>
            </div>
            <div class="tr-tiles">
              <div class="app-tile tr-tile hl">
                <div class="lbl">feed
                  <svg class="ic" style="color:var(--c-feed)" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 3h6M9.5 6h5l.6 13.5a2 2 0 0 1-2 2.5h-2.2a2 2 0 0 1-2-2.5z"></path></svg>
                </div>
                <div class="meta">Today</div>
                <div class="val">435 ml</div>
              </div>
              <div class="app-tile tr-tile">
                <div class="lbl">diaper
                  <svg class="ic" style="color:var(--c-diaper)" width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3c4.2 6 6.2 9 6.2 12.2A6.2 6.2 0 0 1 5.8 15c0-3.2 2-6.2 6.2-12z"></path></svg>
                </div>
                <div class="meta">Today</div>
                <div class="val">1 / 2</div>
              </div>
              <div class="app-tile tr-tile">
                <div class="lbl">sleep
                  <svg class="ic" style="color:var(--c-sleep)" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"></path></svg>
                </div>
                <div class="meta">Today</div>
                <div class="val">0m</div>
              </div>
            </div>
            <div class="app-dock">
              <div class="app-pill">
                <span class="seg">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 11 12 4l8 7M6 10v9h12v-9"></path></svg>
                </span>
                <span class="seg on">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 17 10 11l4 4 6-7M14 8h6v6"></path></svg>
                </span>
              </div>
              <div class="app-fab">+</div>
            </div>
          </PhoneMockup>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Journal screen */
  .jr-list {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .jr-card {
    background: var(--bg-subtle);
    border: 1px solid var(--line-soft);
    border-radius: 14px;
    padding: 14px;
  }
  .jr-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .jr-date {
    display: flex;
    align-items: center;
    gap: 7px;
    font-family: "Urbanist", sans-serif;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 0.07em;
    color: var(--ink-mute);
  }
  .jr-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }
  .jr-go { color: var(--ink-mute); }
  .jr-body {
    font-family: "Source Serif 4", serif;
    font-size: 13px;
    line-height: 1.4;
    color: var(--ink);
    margin-top: 10px;
  }
  .jr-card .app-tag { margin-top: 12px; }

  /* Newborn home screen */
  .nb-head { margin-top: 26px; }
  .nb-age {
    font-size: 21px;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }
  .nb-born {
    margin-top: 4px;
    font-size: 13px;
    color: var(--ink-mute);
  }
  .nb-born b { color: var(--ink); font-weight: 600; }
  .nb-grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
  }
  .nb-grid .app-tile { min-height: 104px; }
  .nb-only { margin-top: auto; }

  /* Trends screen */
  .tr-num {
    margin-top: 18px;
    font-size: 42px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .tr-num small {
    font-size: 14px;
    font-weight: 500;
    color: var(--ink-mute);
  }
  .tr-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 12px;
    font-size: 9px;
    color: var(--ink-soft);
  }
  .tr-legend span {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .tr-legend i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
  }
  .tr-legend b { color: var(--ink); font-weight: 600; }
  .tr-chart { margin-top: 12px; }
  .tr-chart svg {
    width: 100%;
    height: 76px;
    display: block;
  }
  .tr-axis {
    display: flex;
    justify-content: space-between;
    margin-top: 5px;
    font-size: 8px;
    color: var(--ink-mute);
  }
  .tr-tiles {
    margin-top: 14px;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 8px;
  }
  .tr-tile { min-height: 70px; }
  .tr-tile.hl { border-color: var(--c-diaper); }

  @media (max-width: 768px) {
    .feature h2 .it { display: inline; }
  }
</style>
