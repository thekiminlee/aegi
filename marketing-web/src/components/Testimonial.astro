---
---

<section data-scene aria-label="Testimonial" id="stories">
  <div data-scene-content>
    <div class="section-inner quiet-inner">
      <span class="section-number">009</span>
      <blockquote class="quiet-q serif" data-text-reveal>
        "I open aegi the way I used to open a journal —<br />
        not because I have to, but because I want to<br />
        remember the way today felt."
      </blockquote>
      <div class="quiet-attr">— Selena, mother to Koyun & Isuh &middot; early access</div>
    </div>
  </div>
</section>

<style>
  .quiet-inner {
    text-align: center;
  }

  .quiet-q {
    font-size: clamp(28px, 4vw, 56px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--ink);
    max-width: 22ch;
    margin: 24px auto 0;
    border: none;
    padding: 0;
  }

  .quiet-attr {
    margin-top: 32px;
    font-family: "Urbanist", sans-serif;
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }

  @media (max-width: 768px) {
    .quiet-q {
      font-size: clamp(22px, 6vw, 32px);
      max-width: 100%;
    }
  }
</style>
