---
interface Props {
  name?: string;
  time?: string;
  battery?: string;
}
const { name = 'Koyun', time = '9:41', battery = '76' } = Astro.props;
---

<div class="app-sb">
  <span>{time}</span>
  <span class="sb-icons">
    <svg width="16" height="10" viewBox="0 0 16 10" fill="currentColor" aria-hidden="true">
      <rect x="0" y="6" width="3" height="4" rx="1"></rect>
      <rect x="4.5" y="4" width="3" height="6" rx="1"></rect>
      <rect x="9" y="2" width="3" height="8" rx="1"></rect>
      <rect x="13.5" y="0" width="3" height="10" rx="1" opacity="0.3"></rect>
    </svg>
    <svg width="15" height="11" viewBox="0 0 15 11" fill="currentColor" aria-hidden="true">
      <path d="M7.5 11 9.6 8.5a3.2 3.2 0 0 0-4.2 0zM2.7 5.2l1.7 1.9a5.8 5.8 0 0 1 6.2 0l1.7-1.9a8.3 8.3 0 0 0-9.6 0zM0 2.3 1.6 4a10.9 10.9 0 0 1 11.8 0L15 2.3a13.2 13.2 0 0 0-15 0z"></path>
    </svg>
    <span class="sb-batt">{battery}</span>
  </span>
</div>

<div class="app-top">
  <span class="name">
    <span class="dot"></span>{name}<span class="chev">&#9662;</span>
  </span>
  <span class="acts">
    <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <line x1="2" y1="3" x2="18" y2="3"></line>
      <line x1="2" y1="7" x2="13" y2="7"></line>
      <line x1="2" y1="11" x2="9" y2="11"></line>
    </svg>
    <svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
      <line x1="2" y1="4" x2="18" y2="4"></line>
      <line x1="2" y1="10" x2="18" y2="10"></line>
    </svg>
  </span>
</div>
