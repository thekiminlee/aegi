---
const stats = [
  { value: '40', suffix: 'w', label: 'weeks of gentle tracking' },
  { value: '100', suffix: 'D', label: 'days of joy' },
  { value: '5', suffix: '', label: 'types of trends' },
  { value: '∞', suffix: '', label: 'memories, kept privately' },
];
---

<section data-scene aria-label="Statistics">
  <div data-scene-content>
    <div class="section-inner">
      <span class="section-number">008</span>

      <div class="stats-grid" data-stagger>
        {stats.map((s) => (
          <div class="stat" data-reveal>
            <div class="stat-value">{s.value}<span class="stat-suffix">{s.suffix}</span></div>
            <div class="stat-label">{s.label}</div>
          </div>
        ))}
      </div>

      <div class="stats-team">
        <p>
          Designed by a parent, for the parents, who believe motherhood deserves software that feels like a deep breath.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 48px;
    text-align: center;
    margin-top: 24px;
  }

  .stat-value {
    font-family: "Urbanist", sans-serif;
    font-weight: 700;
    font-size: clamp(64px, 10vw, 140px);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  .stat-suffix {
    font-size: 0.4em;
    color: var(--accent-deep);
    margin-left: 2px;
    font-weight: 400;
  }

  .stat-label {
    margin-top: 16px;
    font-size: 14px;
    color: var(--ink-soft);
    max-width: 20ch;
    margin-inline: auto;
  }

  .stats-team {
    margin-top: 72px;
    text-align: center;
  }

  .stats-team p {
    font-family: "Source Serif 4", serif;
    font-size: 20px;
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 56ch;
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .stats-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
    .stat-value {
      font-size: clamp(48px, 15vw, 80px);
    }
  }
</style>
