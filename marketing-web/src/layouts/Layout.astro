---
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />

  <!-- SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#FAF9F7" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta
    name="keywords"
    content="pregnancy tracker, baby tracker, newborn tracker, infant tracker, baby log, feeding tracker, diaper log, sleep tracker, contraction timer, kick counter, baby journal, pregnancy week by week"
  />
  <meta name="author" content="aegi" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="aegi" />
  <meta property="og:locale" content="en_US" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="aegi — pregnancy and baby tracker app" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    rel="preload"
    href="https://fonts.googleapis.com/css2?family=Urbanist:wght@700&display=swap"
    as="style"
  />
  <link
    href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;1,8..60,400&family=Urbanist:wght@300;400;500;600;700&family=Playwright+US:wght@400&display=swap"
    rel="stylesheet"
  />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "aegi",
    "url": "https://aegi.app",
    "logo": "https://aegi.app/favicon.svg",
    "description": "A calm companion through pregnancy and new motherhood.",
    "foundingDate": "2026",
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "MobileApplication",
    "name": "aegi — Pregnancy & Baby Tracker",
    "applicationCategory": "LifestyleApplication",
    "applicationSubCategory": "Pregnancy & Baby Tracker",
    "operatingSystem": "iOS, Android",
    "url": "https://aegi.app",
    "description": "aegi is a calm pregnancy and baby tracker for logging feeds, diapers, sleep, growth and milestones, timing contractions, counting kicks, and keeping a private baby journal.",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
    },
    "featureList": [
      "Pregnancy tracker, week by week",
      "Newborn and infant tracker",
      "Feeding log (formula, expressed, breastfeeding)",
      "Diaper log (wet and dirty)",
      "Sleep tracking",
      "Growth and milestone tracking",
      "Contraction timer",
      "Kick counter",
      "Private baby journal",
      "24-hour activity timeline",
    ],
  })} />
</head>
<body>
  <div class="grain"></div>
  <slot />

  <script>
    import '../scripts/animations';
  </script>
</body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
